<?xml version="1.0" encoding="utf-8"?>
<!--
  The Sparkle feed. The app reads it from raw.githubusercontent.com, off main, at the URL in
  SUFeedURL; each release appends an entry here, generated by Scripts/update-appcast.py from the
  workflow that built and signed the zip.

  An empty channel is a valid feed: Sparkle reads it and reports that there is nothing newer, which
  is the right answer until the first release that ships an updater.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>AutoConnect</title>
        <link>https://raw.githubusercontent.com/sirpooya/AutoConnect/main/appcast.xml</link>
        <description>Most recent changes to AutoConnect.</description>
        <language>en</language>
    </channel>
</rss>
